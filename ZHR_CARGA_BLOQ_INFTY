*****    FOR ALL ENTRIES IN gt_ok
*****    WHERE bname = gt_ok-bname
*****      AND infty = gt_ok-infty.
*****
*****  LOOP AT gt_ok INTO ls_reg.
*****    READ TABLE gt_exist TRANSPORTING NO FIELDS
*****         WITH TABLE KEY bname = ls_reg-bname infty = ls_reg-infty.
*****    IF sy-subrc = 0.
*****      CLEAR ls_log.
*****      ls_log-bname = ls_reg-bname.
*****      ls_log-infty = ls_reg-infty.
*****      ls_log-tipo  = 'X'.
*****      ls_log-msg   = 'Ya existe en ZHR_BLOQ_INFTY (omitido)'.
*****      APPEND ls_log TO gt_log.
*****    ELSE.
*****      APPEND ls_reg TO gt_nuevos.
*****    ENDIF.
*****  ENDLOOP.
*****ENDFORM.
*****
******----------------------------------------------------------------------*
*****FORM grabar.
*****  DATA: ls_reg TYPE ty_reg,
*****        ls_db  TYPE zhr_bloq_infty,
*****        ls_log TYPE ty_log,
*****        lv_begda  TYPE begda,
*****        lv_endda  TYPE endda.
*****
*****  LOOP AT gt_nuevos INTO ls_reg.
*****    CLEAR ls_db.
*****
*****    PERFORM p_fecha USING ls_reg-begda CHANGING lv_begda.
*****    PERFORM p_fecha USING ls_reg-endda CHANGING lv_endda.
*****
*****    ls_db-mandt = sy-mandt.
*****    ls_db-bname = ls_reg-bname.
*****    ls_db-infty = ls_reg-infty.
*****    ls_db-BEGDA = lv_begda.
*****    ls_db-ENDDA = lv_endda.
*****    ls_db-fecha_ingreso = sy-datum.
*****    ls_db-hora  = sy-uzeit.
*****    APPEND ls_db TO gt_db.
*****
*****    CLEAR ls_log.
*****    ls_log-bname = ls_reg-bname.
*****    ls_log-infty = ls_reg-infty.
*****    ls_log-tipo  = 'I'.
*****    IF p_test = abap_true.
*****      ls_log-msg = 'Se insertaria (modo simulacion)'.
*****    ELSE.
*****      ls_log-msg = 'Insertado'.
*****    ENDIF.
*****    APPEND ls_log TO gt_log.
*****  ENDLOOP.
*****
*****  IF gt_db IS INITIAL OR p_test = abap_true.
*****    RETURN.
*****  ENDIF.
*****
*****  INSERT zhr_bloq_infty FROM TABLE gt_db ACCEPTING DUPLICATE KEYS.
*****  IF sy-subrc = 0.
*****    COMMIT WORK.
*****  ELSE.
*****    ROLLBACK WORK.
*****    MESSAGE 'Hubo duplicados al insertar, revise el log' TYPE 'S' DISPLAY LIKE 'W'.
*****  ENDIF.
*****ENDFORM.
*****
******----------------------------------------------------------------------*
*****FORM mostrar_log.
*****  DATA: ls_log TYPE ty_log,
*****        lv_i   TYPE i,
*****        lv_d   TYPE i,
*****        lv_x   TYPE i,
*****        lv_e   TYPE i.
*****
*****  LOOP AT gt_log INTO ls_log.
*****    CASE ls_log-tipo.
*****      WHEN 'I'. lv_i = lv_i + 1.
*****      WHEN 'D'. lv_d = lv_d + 1.
*****      WHEN 'X'. lv_x = lv_x + 1.
*****      WHEN 'E'. lv_e = lv_e + 1.
*****    ENDCASE.
*****  ENDLOOP.
*****
*****  IF p_test = abap_true.
*****    WRITE: / '*** MODO SIMULACION: no se grabo nada ***' COLOR COL_NEGATIVE.
*****  ENDIF.
*****
*****  WRITE: / 'Insertados / a insertar :', lv_i,
*****         / 'Repetidos en archivo     :', lv_d,
*****         / 'Ya existian en tabla     :', lv_x,
*****         / 'Con error                :', lv_e.
*****  SKIP.
*****
*****  WRITE: / 'Linea', 8 'Usuario', 22 'Infty', 29 'Tipo', 34 'Mensaje'.
*****  ULINE.
*****
*****  LOOP AT gt_log INTO ls_log.
*****    CASE ls_log-tipo.
*****      WHEN 'E'. FORMAT COLOR COL_NEGATIVE.
*****      WHEN 'D' OR 'X'. FORMAT COLOR COL_TOTAL.
*****      WHEN 'I'. FORMAT COLOR COL_POSITIVE.
*****    ENDCASE.
*****    WRITE: / ls_log-linea, 8 ls_log-bname, 22 ls_log-infty,
*****             29 ls_log-tipo, 34 ls_log-msg.
*****    FORMAT COLOR OFF.
*****  ENDLOOP.
*****ENDFORM.
